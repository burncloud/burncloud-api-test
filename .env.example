# API提供商选择: openai, azure, 或 claude
PROVIDER=azure

# OpenAI API配置
API_TOKEN=sk-
API_URL=http://127.0.0.1/v1/chat/completions

RPM=30
MODEL=gpt-4o-mini
MAX_TOKENS=500
STREAM=true
PROMPT=写一篇300字小说

# Azure OpenAI 配置
# 请替换为你的 Azure OpenAI 实际配置
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Azure Claude 配置
# Azure 现在支持 Claude 模型，使用 v1/messages 格式
AZURE_CLAUDE_API_KEY=
AZURE_CLAUDE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_CLAUDE_DEPLOYMENT_NAME=claude-3-5-sonnet-20241022
AZURE_CLAUDE_API_VERSION=2025-01-01-preview

# 测试 Claude 配置
PROVIDER=claude

# Azure Claude 配置 (请替换为你的实际配置)
AZURE_CLAUDE_API_KEY=your-claude-api-key-here
AZURE_CLAUDE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_CLAUDE_DEPLOYMENT_NAME=claude-3-5-sonnet-20241022
AZURE_CLAUDE_API_VERSION=2025-01-01-preview